APP_ENV=development
AUTH_MODE=demo
SESSION_SECRET=replace-with-a-long-random-value
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=study_planner

# Set AUTH_MODE=firebase and provide these values to enable real Google sign-in.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT=
SESSION_COOKIE_SECURE=false

# Optional GraphRAG roadmap selection through LiteLLM + Google AI Studio.
# Create a key at https://aistudio.google.com/app/apikey and keep it private.
GEMINI_API_KEY=
AI_ENABLED=true
AI_MODEL=
# Optional comma-separated override; defaults come from llm_config.json.
AI_FALLBACK_MODELS=
AI_TIMEOUT_SECONDS=20

# Account profiles use the existing FalkorDB by default.
# Select firestore only after its database and server credentials are configured.
PROFILE_STORE=falkordb
